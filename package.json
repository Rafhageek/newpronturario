{
  "name": "hubpatients",
  "version": "0.1.0",
  "private": true,
  "description": "HubPatients — Prontuário Pessoal de Saúde (PHR) brasileiro, paciente-first (LGPD + CFM)",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "@types/react": "~19.1.0",
      "@types/react-dom": "~19.1.0"
    }
  },
  "scripts": {
    "dev": "turbo run dev --filter=@hubpatients/web",
    "dev:mobile": "turbo run dev --filter=@hubpatients/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test",
    "security:secrets": "node scripts/security/scan-secrets.mjs",
    "security:deps": "corepack pnpm audit --audit-level high",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "sharp": "^0.35.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
