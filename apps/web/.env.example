# Copie para apps/web/.env.local e preencha com os valores reais do Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# Google Maps (feature de Locais de saúde). Habilitar "Maps JavaScript API" na chave.
# É pública (vai no bundle) — restrinja por referrer HTTP no Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=sua-chave-google-maps
