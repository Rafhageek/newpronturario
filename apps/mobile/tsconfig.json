{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["expo", "nativewind/types"],
    "paths": {
      "@/*": ["./src/*"],
      "@hubpatients/core": ["../../packages/core/src/index.ts"],
      "@hubpatients/core/*": ["../../packages/core/src/*"],
      "@hubpatients/supabase": ["../../packages/supabase/src/index.ts"],
      "@hubpatients/supabase/*": ["../../packages/supabase/src/*"],
      "@hubpatients/ui-tokens": ["../../packages/ui-tokens/src/index.ts"]
    }
  },
  "include": [
    "app",
    "src",
    "*.ts",
    "*.tsx",
    "nativewind-env.d.ts",
    "expo-env.d.ts",
    ".expo/types/**/*.ts"
  ]
}
