# ─────────────────────────────────────────────────────────────
# VidaLog — variáveis de ambiente (EXEMPLO — sem segredos reais)
# Copie para apps/web/.env.local e apps/mobile/.env (ou .env.local)
# Pegue os valores em: Supabase Dashboard → Project Settings → API
# ─────────────────────────────────────────────────────────────

# --- Web (Next.js) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# Usado APENAS em rotas server-side / Edge Functions. NUNCA exponha no client.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-secreta

# --- Mobile (Expo) ---
# Expo só injeta no app variáveis com prefixo EXPO_PUBLIC_
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica
